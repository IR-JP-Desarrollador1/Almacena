APP_NAME=AlmacenaLite
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com

APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Usa los datos exactos de MySQL que aparecen en hPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usuario_nombrebd
DB_USERNAME=usuario_usuario
DB_PASSWORD="REEMPLAZAR_CON_LA_CLAVE_DE_MYSQL"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Completa estos datos con el servicio de correo configurado en hPanel.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.tu-dominio.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@tu-dominio.com
MAIL_PASSWORD="REEMPLAZAR_CON_LA_CLAVE_DEL_CORREO"
MAIL_FROM_ADDRESS=no-reply@tu-dominio.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
